# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
#update_fastlane

default_platform(:ios)

platform :ios do
  before_all do

    api_key = app_store_connect_api_key(
      key_id: ENV['APPLE_CONNECT_KEY_ID'],
      issuer_id: ENV['APPLE_CONNECT_ISSUER_ID'],
      key_content: ENV['APPLE_CONNECT_KEY_CONTENT'],
      is_key_content_base64: true,
      duration: 1000
    )
    lane_context[SharedValues::APP_STORE_CONNECT_API_KEY] = api_key
  end

  desc "Bump build number and version to FASTLANE_BUILD_NUMBER"
  lane :increment_build do
    version = ENV["FASTLANE_BUILD_NUMBER"]
    UI.user_error!("FASTLANE_BUILD_NUMBER environment variable is not set") if version.to_s.empty?
    increment_build_number(build_number: version)
    increment_version_number(version_number: version)
  end

  desc "Build the app for App Store"
  lane :build do
    get_certificates(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      team_id: ENV["FASTLANE_TEAM_ID"],
      generate_apple_certs: false
#       keychain_path: File.expand_path("~/Library/Keychains/fastlane_keychain-db"),
#       keychain_password: ENV["FASTLANE_KEYCHAIN_PASSWORD"]
    )

    ENV["APP_IDENTIFIERS"].to_s.split(',').map(&:strip).each do |app_id|
      sigh(
        app_identifier: app_id,
        api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
        team_id: ENV["FASTLANE_TEAM_ID"],
        skip_install: true,
#         keychain_path: File.expand_path("~/Library/Keychains/fastlane_keychain-db")
      )
    end

    build_app(
      scheme: ENV["FASTLANE_IOS_SCHEME"],
      clean: true,
      output_directory: "build",
      export_method: "app-store"
    )
  end

  desc "Deploy a new beta to TestFlight"
  lane :deploy_beta do
    UI.user_error!("APP_IDENTIFIERS is not set") if ENV['APP_IDENTIFIERS'].to_s.empty?
    UI.user_error!("FASTLANE_BUILD_NUMBER is not set") if ENV['FASTLANE_BUILD_NUMBER'].to_s.empty?

    increment_build
    build

    upload_to_testflight(
      app_identifier: ENV['APP_IDENTIFIERS'].split(',').first,
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      skip_waiting_for_build_processing: true
    )

    UI.success("Successfully deployed to TestFlight")
  end

  error do |lane, exception|
    UI.error("Lane #{lane} failed: #{exception.message}")
  end
end
